cat > .gitignore << 'EOF'
# Environment variables (contains real credentials)
.env
.env.local
.env.*.local
*.env

# Database certificates
*.pem
*.crt
*.key
ca.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv
.venv/
env/

# Models and data
models/
models_saved/
*.pkl
*.joblib
*.pickle
data/
*.csv
!data/.gitkeep
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store

# Docker
*.log
*.pid

# Secrets
secrets/
config/
credentials/
*.secret

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
EOF
.vercel
