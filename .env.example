# Database Configuration - Aiven PostgreSQL (Use your own credentials)
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=your_username
DB_PASSWORD=your_password_here
DB_SSL_MODE=require
DB_SSL_CA=ca.pem

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Model Configuration
MODEL_DIR=./models
RETRAIN_DAY=saturday
RETRAIN_TIME=12:00

# Optional: Kaggle API credentials for downloading dataset
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_key
